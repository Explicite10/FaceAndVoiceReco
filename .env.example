# Copia este archivo a .env en el servidor y llena los valores.
# .env no se sube a git ni entra a la imagen de Docker.

# Puerto del servidor donde queda publicada la API.
API_PORT=7860

# ---------- Acceso ----------
# Una llave por proyecto, proyecto:llave separados por coma (minimo 24 caracteres).
# Generar una: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Vacio = la API queda abierta. TEMPORAL mientras los proyectos prueban.
API_KEYS=

# Origenes de navegador que pueden llamar a la API, separados por coma, con
# https:// y sin / al final. Ej: https://portal.tuempresa.com
# Solo hace falta si un frontend en OTRO dominio llama directo desde el navegador.
# * = cualquier origen. TEMPORAL mientras los proyectos prueban.
CORS_ORIGINS=*

# Si hay un proxy o balanceador delante, su IP: asi el rate limit cuenta por la
# IP real del cliente (X-Forwarded-For) y no por la del proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# ---------- Reto y limites ----------
REQUIRE_CHALLENGE=true
CHALLENGE_TTL_SEC=180
RATE_LIMIT_REQUESTS=10
CHALLENGE_RATE_LIMIT_REQUESTS=30
FACE_MATCH_PERCENT=70
MAX_VIDEO_MB=50
MAX_IMAGE_MB=10

# ---------- Voz a texto ----------
# La imagen trae el modelo "small". Cambiarlo aqui lo descarga al arrancar;
# para incluirlo en la imagen: docker build --build-arg ASR_MODEL_SIZE=medium
ASR_MODEL_SIZE=small
ASR_CPU_THREADS=4
