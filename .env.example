# Copia este archivo a .env en el servidor y llena los valores.
# .env no se sube a git ni entra a la imagen de Docker.

# Puerto del servidor donde queda publicada la API.
API_PORT=7860
# 127.0.0.1 si el proxy HTTPS esta en este mismo servidor (recomendado);
# 0.0.0.0 si el proxy o balanceador esta en otra maquina.
API_BIND=0.0.0.0

# URL publica: con ella se arman los enlaces que reciben los usuarios. Debe ser
# https, o la camara del navegador no funciona.
PUBLIC_URL=https://prueba-de-vida.buzzword.com.mx

# ---------- Base de datos (proyectos y resumen de sesiones) ----------
# Contraseña obligatoria. Generar una:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_USER=vida
POSTGRES_DB=vida

# ---------- Acceso ----------
# false = solo proyectos autorizados (python -m app.cli crear ...). La pagina de
# prueba completa en "/" desaparece y la API directa pide llave.
# true  = modo de pruebas: pagina "/" y API directa sin llave.
DEMO=false

# Llaves fijas opcionales para la API directa, proyecto:llave separados por coma.
# Lo normal es dar de alta proyectos con python -m app.cli.
API_KEYS=

# Origenes de navegador que pueden llamar a la API directa, separados por coma,
# con https:// y sin / al final. La captura por sesion no lo necesita.
CORS_ORIGINS=https://prueba-de-vida.buzzword.com.mx

# Si hay un proxy o balanceador delante, su IP: asi el rate limit cuenta por la
# IP real del cliente (X-Forwarded-For) y no por la del proxy.
# Con el proxy en este mismo servidor, Docker no ve 127.0.0.1 sino la IP de su
# red interna (172.x.x.x): en ese caso usar API_BIND=127.0.0.1 y "*".
FORWARDED_ALLOW_IPS=127.0.0.1

# ---------- Sesiones ----------
SESSION_MINUTES=30
SESSION_MAX_ATTEMPTS=3
# Videos que se analizan a la vez; los demas esperan su turno.
MAX_CONCURRENT_VERIFICATIONS=1
DELIVERY_TIMEOUT_SEC=20
# Minutos que duran las ligas de evidencia (video, fotogramas, cara de la INE). Minimo 30.
EVIDENCE_MINUTES=60
DELIVERY_RETRIES=2

# ---------- Reto y limites ----------
REQUIRE_CHALLENGE=true
CHALLENGE_TTL_SEC=180
RATE_LIMIT_REQUESTS=10
CHALLENGE_RATE_LIMIT_REQUESTS=30
FACE_MATCH_PERCENT=70
# Parecido minimo entre la cara de los gestos y la de la frase (misma persona).
SAME_PERSON_PERCENT=50
MAX_VIDEO_MB=50
MAX_IMAGE_MB=10

# ---------- Voz a texto ----------
# La imagen trae el modelo "small". Cambiarlo aqui lo descarga al arrancar;
# para incluirlo en la imagen: docker build --build-arg ASR_MODEL_SIZE=medium
ASR_MODEL_SIZE=small
ASR_CPU_THREADS=4
