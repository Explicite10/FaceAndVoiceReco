# Copia este archivo a .env en el servidor y llena los valores.
# .env no se sube a git ni entra a la imagen de Docker.

# Puerto del servidor donde queda publicada la demo.
API_PORT=7860

# URL publica (con https:// y sin / al final) que va dentro del codigo QR.
# Vacio = la del navegador que abre el panel.
PUBLIC_URL=

# ---------- Panel (login) ----------
# Unica cuenta del panel. La contraseña nunca va en claro: solo su hash.
# Generar el hash:  docker compose run --rm api python -m app.core.acceso hash
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Firma de las cookies. Generar: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_SESSION_HOURS=8
# Cuanto dura el acceso de quien escaneo el QR.
PARTICIPANT_SESSION_MINUTES=60

# ---------- Expediente ----------
# Carpeta del expediente (INE, video, foto en binario). En Docker es el volumen
# "evidencia" montado en /app/evidencia; no hace falta cambiarla.
# EVIDENCIA_DIR=evidencia

# ---------- Base de datos (Postgres del compose) ----------
# Guarda el token del QR, el resumen de cada sesion y las rutas de su expediente.
POSTGRES_USER=pruebavida
POSTGRES_DB=pruebavida
# Generar: python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# ---------- Acceso para otros proyectos (opcional) ----------
# proyecto:llave separados por coma (minimo 24 caracteres). La pagina de la
# demo no las necesita: entra con el QR.
API_KEYS=
# Origenes de navegador que pueden llamar a la API directo. La demo no lo necesita.
CORS_ORIGINS=

# Si hay un proxy o balanceador delante, su IP: asi el rate limit cuenta por la
# IP real del cliente (X-Forwarded-For) y las cookies salen como Secure (https).
FORWARDED_ALLOW_IPS=127.0.0.1

# ---------- Reto y limites ----------
REQUIRE_CHALLENGE=true
CHALLENGE_TTL_SEC=180
# Verificaciones y retos por sesion del QR (o por IP) en la ventana.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SEC=60
CHALLENGE_RATE_LIMIT_REQUESTS=30
# Sesiones nuevas (escaneos del QR) por IP cada 10 min. Alto porque detras del proxy
# todos pueden llegar con la misma IP. Volver a escanear con sesion vigente no cuenta.
QR_SCANS_PER_IP=300
# Analisis al mismo tiempo; los demas esperan su turno (hasta 90 s).
MAX_CONCURRENT_VERIFICATIONS=2
FACE_MATCH_PERCENT=70
MAX_VIDEO_MB=25
MAX_IMAGE_MB=8
MAX_IMAGE_MEGAPIXELS=25

# ---------- Voz a texto ----------
# La imagen trae el modelo "small". Cambiarlo aqui lo descarga al arrancar;
# para incluirlo en la imagen: docker build --build-arg ASR_MODEL_SIZE=medium
ASR_MODEL_SIZE=small
ASR_CPU_THREADS=4
